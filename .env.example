# Base URL of the Express API (the Socket.io server lives there, not here).
# Must be NEXT_PUBLIC_ because the socket connection and both fetches run in the browser.
#
# Local:    http://localhost:4000
# Deployed: https://<your-service>.onrender.com
#
# Read at BUILD time, not runtime — Next.js inlines NEXT_PUBLIC_* into the bundle.
# Changing this in the Vercel dashboard does nothing until you redeploy.
#
# Whatever origin this app is served from must also appear in the API's
# CORS_ORIGIN allowlist, or the browser will block both the fetch and the
# socket handshake.
NEXT_PUBLIC_API_URL=http://localhost:4000
